{
  "name": "@trioz/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contract between the TrioZ web app (apps/web) and the desktop shell (apps/desktop): Socket.IO path, event names and payload types.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  }
}
