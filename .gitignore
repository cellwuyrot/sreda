# ── User uploads — do NOT delete on deploy (avatars, group icons, etc.) ──
# The folder structure is tracked via .gitkeep files, but actual files are not.
apps/web/public/uploads/avatars/*
apps/web/public/uploads/groups/*
apps/web/public/uploads/messages/*
apps/web/public/uploads/banners/*
!apps/web/public/uploads/avatars/.gitkeep
!apps/web/public/uploads/groups/.gitkeep
!apps/web/public/uploads/messages/.gitkeep
!apps/web/public/uploads/banners/.gitkeep

# ── Приватные загрузки — вне public/, отдаются только после проверки входа ──
# Вложения переписки, голосовые, видео, документы, файлы задач и проектов.
# Файлы не отслеживаются, каталог держится .gitkeep.
apps/web/storage/uploads/*
!apps/web/storage/uploads/.gitkeep

# ── Self-hosted desktop installers — populated at deploy, not tracked ─────
# `npm run desktop:publish` copies electron-builder output here; served from
# /desktop/ and by /api/download/desktop. The folder is tracked via .gitkeep
# and README.md; the (large) binaries and update feeds are not.
apps/web/public/desktop/*
!apps/web/public/desktop/.gitkeep
!apps/web/public/desktop/README.md
