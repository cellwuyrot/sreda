# ─── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://trioz:CHANGE_ME_DB_PASSWORD@localhost:5432/trioz"

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Security ────────────────────────────────────────────────────────
ENCRYPTION_SECRET="generate-with-openssl-rand-base64-32"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── TURN Server (Voice Channels) ───────────────────────────────────
TURN_URL="turn:localhost:3478"
TURN_USERNAME="trioz"
TURN_CREDENTIAL="trioz_turn_secret"

# ─── Почта: сервис отправки ─────────────────────────────────────────
# Основной путь — собственный почтовый сервис (github.com/acoulbot/smtp):
# relay-провайдеры с failover, DKIM, журнал писем, вебхуки.
# Ключ сайта — в его админке: Сайты → API ключ.
SMTP_SERVICE_URL="https://smtp.example.com"
SMTP_SERVICE_KEY="sm_your_site_api_key"
# Необязательно и по умолчанию НЕ задавайте: если задать, этот адрес станет
# отправителем ВСЕХ писем и переопределит адрес ящика (support@, sales@ …).
# Ключ сайта шлёт письма от любого адреса СВОЕГО домена — чужой домен даст 403.
# Оставьте пустым, чтобы письма из раздела «Почта» уходили от адреса ящика,
# а коды входа — от sender-адреса, настроенного на сайте сервиса.
# SMTP_FROM="noreply@trioz.ru"

# ─── Почта: приём писем в админку (вебхук от сервиса) ────────────────
# Сервис шлёт входящие/исходящие письма на POST /api/mail/ingest.
# ОСНОВНОЙ способ — подпись Standard Webhooks: в админке сервиса у вебхука
# есть "signing secret" вида whsec_...; вставьте его сюда как есть.
MAIL_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# Запасной способ (если сервис шлёт простой заголовок X-Mail-Secret):
# MAIL_INGEST_SECRET="придумайте-длинный-секрет"

# ─── Почта: прямой SMTP (запасной путь) ─────────────────────────────
# Используется, только если сервис выше не задан.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
# Шифрование выводится из порта: 465 — implicit TLS, 587 и 25 — STARTTLS.
# Задавайте SMTP_SECURE только чтобы переопределить этот вывод.
# SMTP_SECURE="true"

# ─── Docker Compose ─────────────────────────────────────────────────
POSTGRES_USER="trioz"
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"  # должен совпадать с DATABASE_URL выше
POSTGRES_DB="trioz"

# ─── Seed Passwords (for prisma/seed.ts) ────────────────────────────
SEED_ADMIN_PASSWORD="admin123"
SEED_USER_PASSWORD="user123"
SEED_ACOULBOT_PASSWORD="change-me-in-production"

# Геолокация в чатах работает на бесплатном стеке OpenStreetMap
# (Leaflet-тайлы + Nominatim через /api/geo/reverse) — ключи не нужны.
