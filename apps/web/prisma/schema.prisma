// PREMIUM-PAY: запись о подписке Premium, привязанной к платежу.
// Создаётся администратором в админ-панели при связи с профилем клиента:
// админ выбирает способ оплаты (СБП / эквайринг), сумму и ссылку/чек, а сервис
// одновременно выдаёт пользователю Premium и сохраняет здесь метаданные платежа.
// Несколько записей на пользователя = история подписок/платежей.
model PremiumSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("UserPremiumSubs", fields: [userId], references: [id], onDelete: Cascade)
  plan          String    @default("month") // month | quarter | year | lifetime
  paymentMethod String    @default("manual") // sbp | acquiring | manual
  amount        Int       @default(0) // сумма платежа в минимальной валюте (рубли)
  currency      String    @default("RUB")
  reference     String?   @db.VarChar(200) // номер платежа / чек / комментарий
  note          String?   @db.Text
  status        String    @default("active") // active | canceled | expired
  startedAt     DateTime  @default(now())
  expiresAt     DateTime? // null = бессрочно
  grantedById   String?
  grantedBy     User?     @relation("PremiumSubGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

/// VPN-PLAN: подписка «только VPN».
///
/// Повторяет строение PremiumSubscription и намеренно НЕ объединена с ней
/// полем-видом. Причина практическая: всюду, где читается история Premium
/// (профиль, панель, задача просрочки), запросы идут без фильтра по виду —
/// общая таблица тихо примешала бы VPN-платежи в Premium-выручку и в сроки
/// премиума. Раздельные таблицы делают такую ошибку невозможной.
model VpnSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("UserVpnSubs", fields: [userId], references: [id], onDelete: Cascade)
  plan          String    @default("month") // month | quarter | year | lifetime
  paymentMethod String    @default("manual") // sbp | acquiring | manual
  amount        Int       @default(0)
  currency      String    @default("RUB")
  reference     String?   @db.VarChar(200)
  note          String?   @db.Text
  status        String    @default("active") // active | canceled | expired
  startedAt     DateTime  @default(now())
  expiresAt     DateTime? // null = бессрочно
  grantedById   String?
  grantedBy     User?     @relation("VpnSubGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

