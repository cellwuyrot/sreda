/// Уведомление получателю.
///
/// Кроме получателя запись знает ДВЕ вещи о себе, и обе появились из багов:
///
/// 1. `actorId` — из-за кого уведомление возникло. Раньше о человеке оставался
///    только замороженный текст («andycoulbot: Сотрудничество»), поэтому после
///    удаления аккаунта уведомление о нём продолжало висеть в колокольчике и
///    вести в пустоту. Каскад по этому полю убирает такие записи вместе с
///    человеком.
/// 2. `entityType` + `entityId` — о чём уведомление. Раньше «прочитано»
///    вычислялось сопоставлением ТЕКСТА ссылки (`link contains "section=business"`,
///    `link contains "dm=<id>&"`), а у обращений ссылка ведёт в раздел, а не в
///    заявку, — значит сопоставить было нечего, и прочитанное обращение
///    оставалось непрочитанным уведомлением навсегда. Предмет заменяет эту
///    догадку точным признаком.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Из-за кого уведомление. null — событие не про человека (системное).
  actorId   String?
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  /// О чём уведомление: appeal | dm | channel и тому подобное.
  entityType String? @db.VarChar(32)
  entityId   String?
  /// Сколько событий схлопнуто в это уведомление. N сообщений из одной беседы —
  /// одно уведомление со счётчиком, а не N отдельных строк и N в бейдже.
  count      Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  /// Погасить или убрать всё по предмету — одним запросом.
  @@index([userId, entityType, entityId])
  @@index([actorId])
  // Лента уведомлений: свои, по убыванию даты. Индекс [userId, read] сортировку
  // не покрывает, и база каждый раз сортировала выборку целиком.
  @@index([userId, createdAt])
}

/// PUSH: устройство, на которое можно доставить уведомление, пока приложение
/// закрыто.
///
/// Зачем нужно вообще: уведомления показывались только пока приложение открыто —
/// они приходили живым соединением, и закрытый мессенджер молчал. Доставку в
/// закрытое приложение выполняет служба доставки сообщений телефона, а ей нужен
/// адрес конкретного устройства — он и хранится здесь.
///
/// Токен уникален и ПЕРЕПРИВЯЗЫВАЕТСЯ: на одном телефоне может войти другой
/// человек, и тогда устройство должно принадлежать ему, а прежний владелец
/// перестать получать на него уведомления. Поэтому уникальность по токену, а не
/// по паре «человек и токен».
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Адрес устройства в службе доставки. Не секрет, но и не публичное значение.
  token     String   @unique
  /// android — пока единственная оболочка с доставкой в закрытое приложение.
  platform  String   @default("android") @db.VarChar(16)
  createdAt DateTime @default(now())
  /// Последнее подтверждение, что устройство живо: обновляется при каждом входе.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

