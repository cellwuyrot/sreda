/// WS-HISTORY: снимки состояния рабочей среды.
///
/// Отмена живёт только в текущей вкладке и исчезает вместе с ней, истории
/// версий не было вовсе, а холст можно потерять целиком — чужим сохранением или
/// собственной неосторожностью. Снимок — дешёвая страховка ровно там, где её не
/// было никакой.
///
/// `ownerKey` один на оба режима: идентификатор человека для личной среды и
/// «channel:<id>» для общего холста канала. Отдельная таблица на каждый режим
/// означала бы две одинаковые реализации и два места, где можно забыть чистку
/// старых записей.
model WorkspaceSnapshot {
  id        String   @id @default(cuid())
  /// Кому принадлежит: id пользователя либо "channel:<id>".
  ownerKey  String
  /// Полный снимок состояния — та же строка, что и в рабочем состоянии.
  data      String   @db.Text
  /// Кто сохранился последним перед снимком. Пусто — снимок сделан не человеком.
  byUserId  String?
  createdAt DateTime @default(now())

  @@index([ownerKey, createdAt])
}

// GROUP-WORKSPACE: совместная «Рабочая среда» группы — состояние холстов
// модульного канала типа CANVAS. Одна запись на канал (модуль); внутри JSON
// StoredState с несколькими именованными холстами (до 5). Правки участников
// сохраняются последней записью (last-write-wins) и рассылаются по комнате
// канала через socket.io — так же, как личная среда синхронит устройства.
model ChannelWorkspaceState {
  channelId   String   @id
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  data        String   @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// WS-TABLE: хранилище больших таблиц вне WorkspaceState.
// cells — JSON-строка string[][]. Привязана к cardId внутри Board.
// ownerKey — userId для личной среды, "channel:<id>" — для групповой.
// colWidths/rowHeights — JSON-строки number[] (могут быть null).
model WorkspaceTable {
  id         String   @id @default(cuid())
  ownerKey   String
  cardId     String
  cells      String   @db.Text
  colWidths  String?
  rowHeights String?
  updatedAt  DateTime @updatedAt

  @@unique([ownerKey, cardId])
  @@index([ownerKey])
}

// Раскладка списка сообществ: порядок и папки (JSON как строка).
model GroupLayout {
  userId    String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DmFolderLayout {
  id        String   @id @default(cuid())
  userId    String
  /// Тип раздела: "dm", "business" и т. д.
  kind      String
  /// JSON-массив DmFolder[]
  data      String   @db.Text @default("[]")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}


model GroupAuditEntry {
  id         String   @id @default(cuid())
  groupId    String
  actorId    String
  actorName  String
  action     String
  targetId   String?
  targetName String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// НОВОЕ: известные идентификаторы сети/устройства пользователя: IP-адреса и
// ID устройства (хэш MAC-адресов из десктоп-клиента). Используются для
// остановки учётной записи по IP и MAC при глобальном бане.
model UserIdentity {
  id       String   @id @default(cuid())
  userId   String
  kind     String // "IP" | "DEVICE" (хэш MAC-адресов из десктоп-клиента)
  value    String
  lastSeen DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, value])
  @@index([kind, value])
}

// НОВОЕ: заблокированные идентификаторы. Вход и регистрация с этих IP/устройств
// невозможны, пока запись не удалена (снимается при разбане пользователя).
model BlockedIdentity {
  id        String   @id @default(cuid())
  kind      String
  value     String
  userId    String? // чей бан породил блокировку (для снятия при разбане)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@index([userId])
}

// FIX-CABINET: проект личного кабинета (бывш. Партнёрская). Клиент (CONSULTANT)
// создаёт заявку с материалами, админ/редактор ведёт её по этапам услуги
// (см. apps/web/src/lib/orderStages.ts). Выполненный этап откатить нельзя,
// поэтому прогресс только растёт.
model PartnerProject {
  id        String                  @id @default(cuid())
  ownerId   String
  name      String
  purpose   String                  @db.Text
  domain    String                  @default("")
  /// STAGES: идентификаторы выполненных этапов — ["site-1", "site-2", …].
  ///
  /// Раньше здесь лежали НОМЕРА пунктов единственного вшитого списка. Номера
  /// пережить правку набора этапов не могут: удалённый шаг сдвигает все
  /// следующие, и у проекта оказываются отмечены не те работы. Миграция
  /// 20260911000000 перевела уже накопленные номера в идентификаторы.
  stepsDone Json                    @default("[]")
  files     Json                    @default("[]") // материалы: [{ url, name, size }]
  status    String                  @default("NEW") // NEW | IN_PROGRESS | LAUNCHED
  /// STAGES: услуга, по которой ведётся проект. От неё зависит набор этапов.
  ///
  /// Необязательна и обнуляется при удалении услуги, а не удаляет проект:
  /// работа по нему уже сделана и оплачена, терять её из-за уборки в списке
  /// услуг нельзя. Проект без услуги показывает набор «Создание сайтов» —
  /// единственный, который до появления этой связи в кабинете и существовал.
  serviceId String?
  service   Service?                @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// CHAT: обращение, в разговоре по которому обсуждается этот проект.
  ///
  /// Своего чата у проекта больше нет: разговор ведётся в деловом чате по
  /// обращению (DirectConversation kind = BUSINESS, см. lib/businessChat.ts).
  /// Ссылка проставляется при первом переходе в чат и дальше ведёт ровно в тот
  /// же разговор — без неё каждое нажатие заводило бы новое обращение.
  appealId  String?
  appeal    Appeal?                 @relation(fields: [appealId], references: [id], onDelete: SetNull)
  owner     User                    @relation("UserPartnerProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  messages  PartnerProjectMessage[]
  /// BUSINESS-CABINET: срок сдачи и ответственный сотрудник.
  ///
  /// Раньше и срок, и «кто ведёт» существовали только словами в деловом чате:
  /// партнёр видел их только в переписке, а кабинет не знал о них ничего.
  dueDate       DateTime?
  responsibleId String?
  responsible   User?     @relation("StaffResponsibleProjects", fields: [responsibleId], references: [id], onDelete: SetNull)
  /// BUSINESS-CABINET: счета, документы и история событий по проекту.
  invoices      ProjectInvoice[]
  documents     ProjectDocument[]
  events        ProjectEvent[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([serviceId])
  @@index([appealId])
  @@index([responsibleId])
}

// FIX-CABINET: мини-чат по проекту между клиентом и админом/редактором.
//
// CHAT: интерфейса у этого чата больше нет — разговор по проекту переехал в
// деловой чат по обращению, чтобы не держать два места для одного разговора.
// Таблица оставлена намеренно: в ней лежит уже накопленная переписка, и
// удалять её вместе с интерфейсом значило бы стереть историю работ.
model PartnerProjectMessage {
  id        String         @id @default(cuid())
  projectId String
  authorId  String
  body      String         @db.Text
  isStaff   Boolean        @default(false)
  project   PartnerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User           @relation("UserProjectMessages", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([projectId])
}

// BUSINESS-CABINET: счёт по проекту личного кабинета.
//
// До этого счета жили только в деловом чате (BusinessPayment на разговор),
// поэтому к проекту они никак не привязывались: чтобы узнать, что оплачено,
// нужно было читать переписку. Сумма — в копейках/минимальных единицах (Int),
// чтобы не ловить ошибки округления Float.
model ProjectInvoice {
  id            String         @id @default(cuid())
  projectId     String
  project       PartnerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Номер счёта внутри проекта (1, 2, 3 …), уникален на проект.
  number        Int            @default(1)
  title         String         @db.VarChar(200)
  amount        Int            @default(0)
  currency      String         @default("RUB") @db.VarChar(8)
  /// UNPAID | PAID | CANCELLED — см. lib/projectBusiness.ts.
  status        String         @default("UNPAID") @db.VarChar(16)
  method        String?        @db.VarChar(32)
  reference     String?        @db.VarChar(300)
  note          String?        @db.Text
  dueDate       DateTime?
  paidAt        DateTime?
  createdById   String?
  /// Имя сотрудника сохраняется строкой, а не связью: финансовая
  /// история должна переживать удаление учётной записи.
  createdByName String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([projectId, number])
  @@index([projectId, status])
}

// BUSINESS-CABINET: документ или договор по проекту.
// Файл лежит в закрытой папке /uploads/projects/ (PRIVATE_UPLOAD_DIRS),
// доступ к ней проверяется на сервере, а не «по знанию ссылки».
model ProjectDocument {
  id             String         @id @default(cuid())
  projectId      String
  project        PartnerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// CONTRACT | ACT | APPENDIX | OTHER
  kind           String         @default("CONTRACT") @db.VarChar(16)
  name           String         @db.VarChar(200)
  url            String         @db.VarChar(500)
  size           Int            @default(0)
  mime           String?        @db.VarChar(120)
  uploadedById   String?
  uploadedByName String         @default("")
  createdAt      DateTime       @default(now())

  @@index([projectId, kind])
}

// BUSINESS-CABINET: событие истории проекта (этапы, сроки, счета, документы).
// Автор записан строкой по тем же причинам: история не должна исчезать
// вместе с учётной записью сотрудника или клиента.
model ProjectEvent {
  id        String         @id @default(cuid())
  projectId String
  project   PartnerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// См. EVENT_KINDS в lib/projectBusiness.ts.
  kind      String         @db.VarChar(24)
  title     String         @db.VarChar(200)
  details   String?        @db.Text
  actorId   String?
  actorName String         @default("")
  /// STAFF | CLIENT — чей это шаг.
  actorSide String         @default("STAFF") @db.VarChar(8)
  createdAt DateTime       @default(now())

  @@index([projectId, createdAt])
}

// FIX-DM: персональные настройки личных сообщений: owner настраивает
// поведение по отношению к target (чёрный список, запрет голосовых, автоответ).
model DmUserSetting {
  id               String    @id @default(cuid())
  ownerId          String
  targetId         String
  blacklisted      Boolean   @default(false)
  voiceBan         Boolean   @default(false)
  autoReplyEnabled Boolean   @default(false)
  autoReplyText    String?   @db.Text
  lastAutoReplyAt  DateTime?
  owner            User      @relation("DmSettingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target           User      @relation("DmSettingTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([ownerId, targetId])
  @@index([targetId])
}

// ════════════════════════════════════════════════════════════════════════
// «Общественность» (модуль COMMUNITY): онбординг и подписки календаря.
// ════════════════════════════════════════════════════════════════════════

/// Онбординг-форма группы: настраивается создателем или админом (НЕ модератором).
/// Участник заполняет её, чтобы получить роль-тег roleId после одобрения.
model OnboardingForm {
  id          String   @id @default(cuid())
  groupId     String   @unique
  active      Boolean  @default(false)
  description String   @default("") @db.Text
  /// JSON-массив строк-вопросов (парсится в API)
  questions   String   @default("[]") @db.Text
  roleId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group        Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role         GroupRole?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  applications OnboardingApplication[]
  invites      OnboardingInvite[]
}

/// FIX-ONBSEND: адресная рассылка формы. Управляющий группой отправляет анкету
/// выбранным участникам и/или всем носителям тега — каждый получает личное
/// уведомление от имени группы. Приглашение даёт право заполнить форму даже
/// когда она не включена для всей группы (`OnboardingForm.active = false`).
model OnboardingInvite {
  id     String @id @default(cuid())
  formId String
  /// Дублируется скаляром: рассылка живёт в контексте группы, но связь
  /// достаточно держать через форму (groupId нужен только для выборок).
  groupId   String
  userId    String
  /// Кто отправил (id пользователя) и через какой тег попал получатель.
  sentById  String?
  viaRoleId String?
  createdAt DateTime @default(now())

  form OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
  @@index([groupId, createdAt])
  @@index([userId])
}

/// Заявка участника по онбординг-форме. Не чаще одной в сутки на пользователя.
model OnboardingApplication {
  id           String    @id @default(cuid())
  formId       String
  groupId      String
  userId       String
  /// JSON-массив строк-ответов (по порядку вопросов формы на момент подачи)
  answers      String    @default("[]") @db.Text
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote   String?   @db.VarChar(300)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  form       OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User           @relation("OnboardingApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("OnboardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([userId, groupId, createdAt])
}

/// Подписка пользователя на событие календаря: за ~15 минут до начала придёт
/// личное уведомление (тик рассылки — в server.ts). remindedAt защищает от
/// повторной отправки.
model CalendarEventSubscription {
  id         String    @id @default(cuid())
  eventId    String
  userId     String
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation("CalendarSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

/// GAMES-CATALOG: карточка игры в разделе /games.
///
/// Раньше список игр был захардкоженным массивом в `app/games/page.tsx`: чтобы
/// открыть или скрыть игру, нужен был релиз. Здесь каталог живёт в базе, а
/// админ включает и выключает игры кнопкой.
///
/// Две природы записи (`kind`):
///   OWN     — наша игра, живёт внутри проекта, `launchUrl` — внутренний путь
///             вида `/games/velderan`;
///   PARTNER — игра сторонней студии. Мы не размещаем её код: разработчик даёт
///             базовый адрес своего API и ключ, мы забираем манифест и держим
///             карточку в актуальном состоянии.
model GameEntry {
  id String @id @default(cuid())

  /// Часть URL для своих игр и стабильный идентификатор для партнёрских.
  slug        String  @unique
  title       String
  description String  @default("") @db.Text
  /// Обложка: внутренний путь (/games/...) или абсолютный https-адрес.
  cover   String?
  players String  @default("")
  /// Метки для карточки, через запятую. Массив здесь не нужен: значения
  /// приходят целиком, поиска по отдельной метке нет.
  tags String @default("")

  /// OWN | PARTNER
  kind String @default("OWN")
  /// Показывать ли игру в /games. Новая запись выключена: партнёрскую карточку
  /// сначала нужно связать с API и убедиться, что манифест отвечает.
  active    Boolean @default(false)
  sortOrder Int     @default(0)

  /// Куда ведёт карточка. Для партнёрских заполняется из манифеста.
  launchUrl String @default("")

  // ── Партнёрская интеграция ────────────────────────────────────────────
  /// База API разработчика, только https. Пусто у своих игр.
  apiBaseUrl String @default("")
  /// Ключ разработчика в зашифрованном виде (`lib/encryption`). Наружу не
  /// отдаётся никогда — ни в админку, ни тем более в публичный список: в
  /// ответах фигурирует только `apiKeyPreview` из последних символов.
  apiKey String?
  /// PENDING | OK | ERROR — состояние последней сверки с манифестом.
  linkState String @default("PENDING")
  /// Текст последней ошибки связки, чтобы админ не гадал, почему нет игры.
  linkError String  @default("") @db.VarChar(500)
  /// Название студии из манифеста.
  partnerName String @default("")
  /// Сколько игроков онлайн по данным партнёра, если он их отдаёт.
  onlinePlayers Int?
  lastSyncAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([kind])
}

/// Указатель «файл → чему он принадлежит».
///
/// Нужен, чтобы при выдаче файла можно было спросить право на канал, беседу
/// или задачу. До него такого пути не было: вложения сообщений хранятся в
/// JSON-поле, и от адреса файла к его месту было не дойти — поэтому ссылка,
/// попавшая к посто��оннему участнику платформы, работала.
///
/// Связей (relation) намеренно нет: строка переживает удаление сообщения.
/// Автоочистка вложений по сроку отозвана — файл живёт столько же, сколько
/// сообщение, к которому приложен.
/// BUILDS: задача на сборку клиентского приложения на сервере.
///
/// До этого сборки делались руками на своём ПК и заливались на сервер. Теперь
/// очередь живёт здесь: администратор ставит задачу в панели, агент сборки
/// (apps/builder) её забирает и кладёт готовые файлы в то же хранилище
/// загрузок, откуда они раздавались раньше — путь скачивания не меняется.
model BuildJob {
  id String @id @default(cuid())
  /// ANDROID | WINDOWS
  target String
  /// QUEUED | RUNNING | SUCCESS | FAILED | CANCELED
  status String @default("QUEUED")
  /// Ветка или коммит, с которого собираем.
  ref String @default("main")
  /// Версия собранного приложения — как её сообщил агент.
  version String @default("")
  /// Кто поставил задачу. Пусто — поставлена не человеком (по расписанию).
  requestedById String?
  /// Узел-сборщик, взявший задачу. Обычно это агент на главном сервере.
  nodeId String?
  /// Хвост журнала сборки: начало обрезается, конец нужнее — ошибка в нём.
  log String @default("") @db.Text
  /// Файлы, попавшие в хранилище загрузок, через запятую.
  artifacts String @default("") @db.Text
  /// Короткая причина отказа для показа в панели.
  error     String    @default("") @db.VarChar(300)
  createdAt DateTime  @default(now())
  startedAt DateTime?
  /// Последняя весточка от агента: по ней видно зависшую сборку.
  heartbeatAt DateTime?
  finishedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model UploadedFile {
  id             String   @id @default(cuid())
  /// Путь внутри каталога загрузок: "messages/uuid.webp".
  path           String   @unique
  /// Первый сегмент пути: messages, voice, documents, tasks, projects.
  dir            String
  uploaderId     String
  channelId      String?
  conversationId String?
  taskId         String?
  /// STORAGE-PRIORITY: где физически лежит файл. null — на главном сервере
  /// (диск приложения), иначе id узла хранения. Адрес файла в переписке при
  /// переезде НЕ меняется: место знает только раздатчик.
  nodeId         String?
  /// Размер в байтах на момент записи. Нужен переносу: по нему видно, сколько
  /// осталось переложить, и он же служит проверкой после копирования.
  size           Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([nodeId])
  @@index([channelId])
  @@index([conversationId])
  @@index([taskId])
}

/// Свои эмодзи сообщества.
///
/// Принадлежат сообществу и только ему: перенести эмодзи в другое сообщество
/// нельзя — набор всегда часть места, где его собрали. Поэтому groupId стоит в
/// уникальном ключе вместе с именем, а не отдельная «библиотека наборов».
///
/// Имя — то, что человек печатает в сообщении: `:name:`. Уникально внутри
/// сообщества, чтобы разбор текста был однозначным.
/// Словарь цензуры сообщества.
///
/// Запись — корень или слово в нижнем регистре: разбор идёт подстрокой, чтобы
/// не вносить в словарь все падежи (см. lib/censor). Уровень решает, что
/// произойдёт при упоминании: запрет отправки, предупреждение человеку или
/// молчаливый учёт.
///
/// Раздел доступен, когда у владельца сообщества есть Premium. Проверка живёт в
/// маршруте, а не в схеме: подписка приходит и уходит, а словарь при её
/// окончании стирать неправильно — он вернётся вместе с подпиской.
model GroupCensorWord {
  id          String   @id @default(cuid())
  groupId     String
  word        String   @db.VarChar(64)
  /// BLOCK | WARN | WATCH — значения перечислены в lib/censor.
  level       String   @default("WATCH") @db.VarChar(8)
  createdById String
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, word])
  @@index([groupId])
}

/// Замеченное упоминание слова из словаря — то, из чего складывается счётчик.
///
/// Слово хранится снимком, а не ссылкой на запись словаря: администратор может
/// убрать слово из словаря, и тогда история наблюдений не должна опустеть — она
/// объясняет, почему у человека такой счётчик.
///
/// Связи с User намеренно нет, только userId: строка переживает удаление
/// участника, а имена для сводки берутся отдельным запросом.
model CensorHit {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  word      String   @db.VarChar(64)
  level     String   @db.VarChar(8)
  /// Где замечено. Пусто, если сообщение было не в канале.
  channelId String?
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, userId])
  @@index([groupId, createdAt])
}

model GroupEmoji {
  id          String   @id @default(cuid())
  groupId     String
  /// Короткое имя без двоеточий: буквы, цифры и подчёркивание.
  name        String   @db.VarChar(32)
  /// Адрес готовой картинки 128×128 (WebP), собранной сервером при загрузке.
  url         String
  createdById String
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@index([groupId])
}

/// REMIND: напоминание, поставленное на карточке рабочей среды.
///
/// Само время лежит и в карточке — чтобы колокольчик показывал состояние без
/// запроса, — но сработать карточка не может: это кусок JSON, который читают
/// только при открытии холста. Поэтому время дублируется сюда, а сервер раз в
/// полминуты проверяет, чему пора (см. sweeper в server.ts).
///
/// Одна карточка — одно напоминание: повторная постановка заменяет прежнее.
model CardReminder {
  id       String @id @default(cuid())
  userId   String
  /// Идентификатор карточки на холсте. Уникален в пределах человека.
  cardId   String
  /// Заголовок карточки на момент постановки: в уведомлении нужен текст, а
  /// заглянуть в чужой JSON состояния сервер не может.
  title    String @db.VarChar(160)
  /// Куда открыть по нажатию: путь внутри приложения.
  link     String @db.VarChar(300)
  remindAt DateTime
  /// Когда сработало. Пусто — ещё ждёт.
  firedAt   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([remindAt, firedAt])
}

/// ───────────────────────────────────────────────────────────────────────────
/// BUSINESS-PAY: счёт по деловому разговору.
///
/// Как это работает целиком:
///
///   услуга (Service.documents) ──копия при выставлении──► счёт (documents)
///        администрация готовит               клиент читает и подписывает
///                                                        │
///                                            после оплаты ─► BusinessContract[]
///
/// Документы КОПИРУЮТСЯ в счёт, а не читаются из услуги по ссылке, и это главное
/// решение здесь. Клиент подписывает конкретные бумаги в конкретный день. Если бы
/// счёт ссылался на услугу, то любая правка договора администрацией задним числом
/// меняла бы то, под чем человек уже подписался. Так делать нельзя.
/// ───────────────────────────────────────────────────────────────────────────
model BusinessPayment {
  id             String             @id @default(cuid())

  /// Разговор, в шапке которого горит кнопка «Оплачено / Не оплачено».
  conversationId String             @unique
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Услуга, из которой взяты документы. SetNull, а не Cascade: удалённая услуга
  /// не должна уносить с собой оплаченный счёт и подписанные договоры.
  serviceId      String?
  service        Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  title          String             @db.VarChar(200)
  description    String?            @db.Text

  /// Сумма в КОПЕЙКАХ (целое). Деньги дробным числом — классическая ошибка
  /// округления, а цена здесь — юридически значимое число.
  amount         Int                @default(0)
  currency       String             @default("RUB") @db.VarChar(8)

  /// Реквизиты/инструкция к оплате текстом. Заполняет администрация; если
  /// пусто — клиенту показываются общие реквизиты проекта (lib/paymentSettings).
  requisites     String?            @db.Text

  /// BUSINESS-SUB: способ выставления — ONE_TIME (разовый счёт) или SUBSCRIPTION
  /// (периодические списания). Строкой, как и status: значения растут (полугодие,
  /// рассрочка), а миграция enum'а в Postgres — отдельная боль на каждое новое.
  mode           String             @default("ONE_TIME") @db.VarChar(16)

  /// Расчётный период подписки: MONTH | QUARTER | YEAR. У разового счёта пусто.
  period         String?            @db.VarChar(16)

  /// Сколько всего списаний пре��усмотрено; null — бессрочно, до отмены.
  cycles         Int?

  /// Сколько периодов уже оплачено и подтверждено администрацией. У разового
  /// счёта 0 или 1 — та�� одна и та же арифметика годится для обоих способов.
  paidCycles     Int                @default(0)

  /// Дата следующего платежа. Когда она наступает, счёт возвращается в SIGNED
  /// (не в UNPAID: документы подписаны один раз на всю подписку).
  nextDueAt      DateTime?

  /// Снимок документов услуги на момент выставления — тот же формат,
  /// что и Service.documents.
  documents      Json?

  /// UNPAID → SIGNED → AWAITING → PAID. Строкой, как и остальные статусы в проекте.
  ///
  ///   UNPAID   — счёт выставлен, клиент ещё не подписал документы;
  ///   SIGNED   — ознакомился и подписал, можно платить;
  ///   AWAITING — нажал «Я оплатил», ждёт проверки;
  ///   PAID     — администрация подтвердила поступление.
  ///
  /// Подтверждает оплату человек, а не кнопка клиента: самопровозглашённая оплата
  /// открывала бы доступ к работам бесплатно.
  status         String             @default("UNPAID") @db.VarChar(16)

  /// Подпись клиента: когда ознакомился с документами и именем, которым подписался.
  signedAt       DateTime?
  signedName     String?            @db.VarChar(200)

  /// Когда клиент сообщил об оплате и что написал (номер чека и т. п.).
  declaredAt     DateTime?
  declaredNote   String?            @db.Text

  /// Когда администрация подтвердила поступление денег.
  paidAt         DateTime?

  createdById    String?
  createdBy      User?              @relation("BusinessPaymentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// PAY-TEMPLATE: шаблон реквизитов, из которого счёт выставлен. Текст в
  /// `requisites` остаётся СНИМКОМ: правка шаблона не переписывает уже
  /// выставленный счёт — иначе условия менялись бы у клиента за спиной.
  requisiteId    String?
  requisite      PaymentRequisite?  @relation(fields: [requisiteId], references: [id], onDelete: SetNull)

  contracts      BusinessContract[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([serviceId])
  @@index([requisiteId])
}

/// PAY-TEMPLATE: шаблон платёжных реквизитов.
///
/// ── Зачем отдельная таблица, а не поля в SiteConfig ────────────────────
///
/// В SiteConfig лежит ОДИН набор реквизитов проекта. Пока счёт выставляет один
/// человек от одного юрлица, этого хватает. Как только администраторов больше
/// одного, набор перестаёт быть один: у каждого своё ИП, свой СБП-телефон и свой
/// терминал эквайринга, а часть работ идёт через общее юрлицо. Один набор в этой
/// ситуации приводит к тому, что реквизиты каждый раз дописывают в счёт руками —
/// и рано или поздно клиент платит не туда.
///
/// Поэтому шаблон — это запись: у неё есть имя, владелец и признак «по умолчанию».
/// `ownerId = null` — общий шаблон проекта, виден всем администраторам.
/// `ownerId = <администратор>` — личный: чужие личные шаблоны другим не видны и
/// не редактируются, это чужие банковские данные, а не общий справочник.
model PaymentRequisite {
  id                String   @id @default(cuid())

  name              String   @db.VarChar(120)

  /// BUSINESS — счета делового чата, PREMIUM — подписка Premium. Строкой, как и
  /// остальные перечисления проекта: значения будут расти.
  scope             String   @default("BUSINESS") @db.VarChar(16)

  /// Владелец личного шаблона; null — общий шаблон проекта.
  ownerId           String?
  owner             User?    @relation("PaymentRequisiteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Подставляется в форму счёта без выбора. Личный шаблон по умолчанию
  /// главнее общего: человек выставляет счёт от себя чаще, чем от проекта.
  isDefault         Boolean  @default(false)

  orgName           String   @default("") @db.VarChar(200)
  inn               String   @default("") @db.VarChar(20)
  kpp               String   @default("") @db.VarChar(20)
  bank              String   @default("") @db.VarChar(200)
  bik               String   @default("") @db.VarChar(20)
  account           String   @default("") @db.VarChar(34)
  corrAccount       String   @default("") @db.VarChar(34)
  purpose           String   @default("") @db.VarChar(300)

  sbpEnabled        Boolean  @default(false)
  sbpPhone          String   @default("") @db.VarChar(32)
  sbpBank           String   @default("") @db.VarChar(120)
  sbpRecipient      String   @default("") @db.VarChar(200)

  acquiringEnabled  Boolean  @default(false)
  acquiringProvider String   @default("") @db.VarChar(120)
  acquiringLink     String   @default("") @db.VarChar(500)
  acquiringMerchant String   @default("") @db.VarChar(120)

  comment           String?  @db.Text

  /// Готовый текст реквизитов целиком. Если заполнен — в счёт идёт он, а не
  /// собранный из полей: бывают формулировки, которые нельзя ужать в поля
  /// (агентский договор, НДС, ссылка на приложение).
  bodyOverride      String?  @db.Text

  /// Значения по умолчанию для формы счёта.
  mode              String   @default("ONE_TIME") @db.VarChar(16)
  period            String?  @db.VarChar(16)

  /// Кем создан — для общих шаблонов важно понимать, с кого спросить.
  createdById       String?
  createdByName     String   @default("") @db.VarChar(120)

  /// Сколько счетов выставлено по шаблону и когда в последний раз.
  usedCount         Int      @default(0)
  lastUsedAt        DateTime?

  payments          BusinessPayment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([scope, ownerId])
  @@index([ownerId, isDefault])
}

/// BUSINESS-PAY: подписанный договор по оплаченному счёту.
///
/// Добавлять могут ОБЕ стороны, и это не послабление: подписанный экземпляр
/// есть у каждой, и требовать, чтобы клиент пересылал свой скан сообщением в чат,
/// а администрация вручную его подшивала, — тот же самый беспорядок, от которого
/// уходим. Видны только участникам разговора и администрации.
model BusinessContract {
  id           String          @id @default(cuid())
  paymentId    String
  payment      BusinessPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  name         String          @db.VarChar(255)
  url          String
  size         Int             @default(0)
  mime         String?         @db.VarChar(128)

  uploadedById String?
  uploadedBy   User?           @relation("BusinessContractAuthor", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime        @default(now())

  @@index([paymentId, createdAt])
}


/// PROFILE-WALL: подписка одного человека на другого.
///
/// Почему не переиспользована Friendship: дружба двусторонняя и требует согласия
/// (PENDING → ACCEPTED), а подписка односторонняя и мгновенная. Смешать их в одной
/// таблице значило бы, что отказ от дружбы тихо отписывает от ленты, а отписка —
/// расторгает дружбу.
///
/// Пара уникальна на уровне базы: два быстрых нажатия «Подписаться» иначе дали бы две
/// строки и счётчик подписчиков «2» от одного человека.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowTarget", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  // Список «на кого подписан я» и «кто подписан на меня» — два разных обхода,
  // оба с сортировкой по дате и постраничной выдачей по 15.
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

/// PROFILE-WALL: запись на личной странице.
///
/// Почему не Message, как у новостей: пост новостей живёт в канале и все его права
/// считаются от членства в группе. У стены канала нет, и единственный владелец —
/// человек. Попытка уложить стену в Message потребовала бы либо фиктивного канала на
/// каждого человека, либо необязательного channelId — и тогда КАЖДЫЙ запрос к
/// сообщениям и каждая проверка прав в проекте должны были бы учитывать строки без
/// канала. Цена ошибки там — утечка переписки, поэтому стена — своя таблица.
model WallPost {
  id             String         @id @default(cuid())
  authorId       String
  author         User           @relation("WallAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Заголовок необязателен — как и в новостях.
  title          String?        @db.VarChar(200)
  content        String         @db.Text
  /// Обложка и вложения — только пути внутри хранилища (/uploads/...): чужой
  /// адрес сделал бы стену способом собирать адреса читателей чужим сервером.
  cover          String?        @db.VarChar(400)
  attachments    String?        @db.Text
  pinned         Boolean        @default(false)
  views          Int            @default(0)
  commentsClosed Boolean        @default(false)
  deleted        Boolean        @default(false)
  editedAt       DateTime?
  createdAt      DateTime       @default(now())
  comments       WallComment[]
  postViews      WallPostView[]

  // Стена: закреплённое сверху, дальше по убыванию даты, по 15 на страницу.
  @@index([authorId, createdAt])
  @@index([authorId, pinned, createdAt])
}

/// PROFILE-WALL: комментарий к записи на стене.
model WallComment {
  id        String   @id @default(cuid())
  postId    String
  post      WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("WallCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

/// PROFILE-WALL: кто уже видел запись. Без этих строк счётчик накручивался бы
/// обновлением страницы — так же, как решено в новостях (PostView).
model WallPostView {
  id        String   @id @default(cuid())
  postId    String
  post      WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("WallViewer", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

/// MAIL-WHITELIST: разрешённые почтовые домены для регистрации.
///
/// Запись в таблице — единственное основание пропустить адрес. Связи с User
/// намеренно нет, только createdById: строка переживает удаление администратора,
/// иначе увольнение сотрудника тихо открывало бы регистрацию всем подряд.
///
/// active позволяет закрыть домен на время, не теряя строку и примечание к ней.
model EmailDomainWhitelist {
  id          String   @id @default(cuid())
  domain      String   @unique @db.VarChar(100)
  note        String   @default("") @db.VarChar(80)
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/// ABOUT-BLOCKS: лендинг-блоки страницы /about.
/// Каждый блок = заголовок + описание + опциональное медиа (фото/видео),
/// настраиваемый макет, форма, свечение и отступ.
model AboutBlock {
  id        String   @id @default(cuid())
  type      String   // hero | video | stats | gallery | bento | timeline | team | cta
  position  Int      @default(0)
  data      String   @default("{}") @db.Text
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([type])
}
