generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  city                   String?
  id                     String                      @id @default(cuid())
  email                  String                      @unique
  username               String                      @unique
  name                   String
  password               String
  avatar                 String?
  role                   String                      @default("USER")
  emailVerified          Boolean                     @default(false)
  /// FIX-SEC: момент последней смены пароля. Сессия живёт в подписанном cookie,
  /// а не в базе, поэтому только эта отметка позволяет обесценить ранее выданные
  /// токены: при расхождении с токеном сессия считается завершённой (lib/auth.ts).
  passwordChangedAt      DateTime?
  banned                 Boolean                     @default(false)
  banReason              String?
  bannedUntil            DateTime?
  /// FIX-KEEP-CONTENT: аккаунт не удаляется физически, иначе каскад onDelete: Cascade
  /// уносит созданные им каналы, новости, задачи, статьи, опросы и сообщения.
  /// Вместо удаления профиль обезличивается (lib/deletedUser.ts), а вход по нему
  /// закрывается по этому флагу (lib/auth.ts).
  isDeleted              Boolean                     @default(false)
  deletedAt              DateTime?
  /// FIX-VAULTPW: пароль «Сейфа» в личных сообщениях. Хранится только
  /// bcrypt-хеш; пустое значение = пароль ещё не задан, и при первом
  /// входе человека просят его придумать.
  vaultPasswordHash      String?
  bio                    String?                     @db.VarChar(200)
  socialLinks            String?                     @db.Text
  customStatus           String?                     @db.VarChar(100)
  statusEmoji            String?                     @db.VarChar(10)
  statusType             String?                     @default("online") @db.VarChar(20)
  activityEnabled        Boolean                     @default(false) // FIX-ACT: чекбокс «Показывать мою активность»
  activityStatus         String?                     @db.VarChar(80) // FIX-ACT: «Слушает музыку в Spotify» (от десктопа)
  activityUpdatedAt      DateTime? // FIX-ACT: свежесть активности (TTL на чтении)
  privacyOnline          String                      @default("everyone")
  privacyFriends         String                      @default("everyone")
  privacyEmail           Boolean                     @default(false)
  notifySound            Boolean                     @default(true)
  notifyPush             Boolean                     @default(true)
  /// Письма по обращениям через тот же почтовый сервис, что рассылает коды
  /// входа. Клиенту — об ответе и смене состояния его заявки, администратору и
  /// редактору — о новых заявках. По умолчанию включено: письмо приходит либо по
  /// обращению, которое человек сам начал, либо по работе, которая ему поручена.
  notifyEmail            Boolean                     @default(true)
  mutedGroups            String?                     @db.Text
  mutedChannels          String?                     @db.Text
  messages               Message[]
  channelMembers         ChannelMember[]
  groupMembers           GroupMember[]
  ownedGroups            Group[]                     @relation("GroupOwner")
  groupBans              GroupBan[]                  @relation("GroupBanUser")
  groupBansIssued        GroupBan[]                  @relation("GroupBanIssuer")
  reportsFiled           GroupReport[]               @relation("GroupReportReporter")
  reportsAgainst         GroupReport[]               @relation("GroupReportTarget")
  reportsHandled         GroupReport[]               @relation("GroupReportHandler")
  ignoring               UserIgnore[]                @relation("UserIgnoreOwner")
  ignoredBy              UserIgnore[]                @relation("UserIgnoreTarget")
  identities             UserIdentity[]
  invitesCreated         Invite[]
  aiChats                AiChat[]
  friendsSent            Friendship[]                @relation("FriendshipSender")
  friendsReceived        Friendship[]                @relation("FriendshipReceiver")
  hostedGameRooms        GameRoom[]                  @relation("GameHost")
  gamePlayers            GamePlayer[]
  gameInvitesSent        GameInvite[]                @relation("GameInviteSender")
  gameInvitesRecvd       GameInvite[]                @relation("GameInviteReceiver")
  reactions              Reaction[]
  badges                 UserBadge[]
  sessions               UserSession[]
  dmConversations1       DirectConversation[]        @relation("DMUser1")
  dmConversations2       DirectConversation[]        @relation("DMUser2")
  dmHandled              DirectConversation[]        @relation("DMHandler")
  /// BUSINESS-PAY: счета, выставленные этим сотрудником, и загруженные им договоры.
  businessPayments       BusinessPayment[]           @relation("BusinessPaymentAuthor")
  businessContracts      BusinessContract[]          @relation("BusinessContractAuthor")
  directMessages         DirectMessage[]
  notifications          Notification[]
  /// Уведомления, возникшие ИЗ-ЗА этого человека. Каскад: удалили аккаунт —
  /// исчезли и уведомления о нём, а не остались текстом без хозяина.
  notificationsCaused    Notification[]              @relation("NotificationActor")
  onboardingApplications OnboardingApplication[]     @relation("OnboardingApplicant")
  onboardingInvites      OnboardingInvite[]
  vpnPeer                VpnPeer?
  pushDevices            PushDevice[]
  onboardingReviews      OnboardingApplication[]     @relation("OnboardingReviewer")
  calendarSubscriptions  CalendarEventSubscription[] @relation("CalendarSubscriptions")
  workspaceState         WorkspaceState?
  /// REMIND: напоминания, поставленные на карточках рабочей среды.
  cardReminders          CardReminder[]
  /// NEWSPOST: посты ленты новостей, которые человек уже просмотрел.
  postViews              PostView[]
  // FIX-DM: персональные настройки ЛС (ЧС / голосовые / автоответ)
  dmSettingsOwned        DmUserSetting[]             @relation("DmSettingOwner")
  dmSettingsTargeted     DmUserSetting[]             @relation("DmSettingTarget")
  groupLayout            GroupLayout?
  dmFolderLayouts        DmFolderLayout[]
  channelMutes           ChannelMute[]
  polls                  Poll[]                      @relation("UserPolls")
  pollVotes              PollVote[]
  tasksCreated           ChannelTask[]               @relation("TaskCreator")
  tasksAssigned          ChannelTask[]               @relation("TaskAssignee")
  tasksClosed            ChannelTask[]               @relation("TaskClosedBy")
  taskComments           TaskComment[]
  taskAttachments        TaskAttachment[]            @relation("UserTaskAttachments")
  messageReads           MessageRead[]
  scheduledMsgs          ScheduledMessage[]
  qaThreads              QAThread[]
  appeals                Appeal[]
  appealMessages         AppealMessage[]
  wikiArticles           WikiArticle[]               @relation("WikiAuthor")
  qaAnswers              QAAnswer[]
  qaVotes                QAVote[]
  wikiRevisions          WikiRevision[]              @relation("WikiEditor")
  calendarEvents         CalendarEvent[]             @relation("UserCalendarEvents")
  workspaceFiles         WorkspaceFile[]             @relation("UserWorkspaceFiles")
  avatarGlowEnabled      Boolean                     @default(false)
  avatarGlowColors       String?
  profileBanner          String?                     @db.Text
  e2eePublicKey          String?                     @db.Text
  isPremium              Boolean                     @default(false)
  /// VPN-PLAN: отдельная подписка только на VPN.
  ///
  /// Зачем отдельный признак, а не `isPremium`: VPN берут ради самого VPN,
  /// и выдавать вместе с ним темы, битрейт голоса и лимиты сообществ было бы
  /// обманом в две стороны: человек платит не за то, что получает, а Premium
  /// теряет смысл. Поэтому право на туннель = Premium ИЛИ эта подписка.
  ///
  /// Срок хранится рядом с флагом намеренно: проверка права идёт на каждом
  /// отчёте VPN-узла (раз в минуту), и тянуть для этого таблицу подписок на
  /// каждого пира значило бы платить за чистоту модели каждой минутой работы.
  /// `vpnAccessUntil = null` при включённом флаге — бессрочно.
  vpnAccess              Boolean                     @default(false) // VPN-PLAN
  vpnAccessUntil         DateTime? // VPN-PLAN
  showOnline             Boolean                     @default(true)
  tosAccepted            Boolean                     @default(false)
  lastSeen               DateTime?
  usernameChangedAt      DateTime?
  partnerProjects        PartnerProject[]            @relation("UserPartnerProjects") // FIX-CABINET
  projectMessages        PartnerProjectMessage[]     @relation("UserProjectMessages") // FIX-CABINET
  responsibleProjects    PartnerProject[]            @relation("StaffResponsibleProjects") // BUSINESS-CABINET
  paymentRequisites      PaymentRequisite[]          @relation("PaymentRequisiteOwner") // PAY-TEMPLATE
  vpnSubscriptions       VpnSubscription[]           @relation("UserVpnSubs") // VPN-PLAN
  vpnSubsGranted         VpnSubscription[]           @relation("VpnSubGranter") // VPN-PLAN
  premiumSubscriptions   PremiumSubscription[]       @relation("UserPremiumSubs") // PREMIUM-PAY
  premiumSubsGranted     PremiumSubscription[]       @relation("PremiumSubGranter") // PREMIUM-PAY
  /// PROFILE-WALL: личная страница — свои записи, комментарии, просмотры и подписки.
  wallPosts              WallPost[]                  @relation("WallAuthor") // PROFILE-WALL
  wallComments           WallComment[]               @relation("WallCommentAuthor") // PROFILE-WALL
  wallViews              WallPostView[]              @relation("WallViewer") // PROFILE-WALL
  following              Follow[]                    @relation("FollowFollower") // PROFILE-WALL
  followers              Follow[]                    @relation("FollowTarget") // PROFILE-WALL
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([email])
  @@index([username])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   @default("register")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Group {
  id                     String                  @id @default(cuid())
  name                   String
  icon                   String?
  description            String                  @default("")
  rules                  String                  @default("") @db.Text
  isMain                 Boolean                 @default(false)
  sectionsEnabled        Boolean                 @default(false)
  ownerId                String
  owner                  User                    @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  channels               Channel[]
  members                GroupMember[]
  invites                Invite[]
  roles                  GroupRole[]
  bans                   GroupBan[]
  reports                GroupReport[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  banner                 String?                 @db.Text
  /// GROUP-SKIN: оформление сообщества (JSON, см. lib/groupTheme.ts)
  theme                  String                  @default("") @db.Text
  requireRules           Boolean                 @default(false)
  /// NEW: пауза группы (��скелетирование»): контент виден только OWNER/ADMIN
  paused                 Boolean                 @default(false)
  auditEntries           GroupAuditEntry[]
  onboardingForm         OnboardingForm?
  onboardingApplications OnboardingApplication[]
  emojis                 GroupEmoji[]
  censorWords            GroupCensorWord[]
  censorHits             CensorHit[]
}

// A user banned from a specific group: removed from the member list and
// blocked from re-joining through invites until the ban is lifted.
model GroupBan {
  id         String   @id @default(cuid())
  groupId    String
  userId     String
  reason     String?  @db.VarChar(300)
  bannedById String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User     @relation("GroupBanUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy   User     @relation("GroupBanIssuer", fields: [bannedById], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// MODERATION: жалоба участника на сообщение или на человека.
///
/// Единственная мера, доступная обычному участнику помимо игнора: игнор
/// прячет собеседника от него одного, жалоба зовёт модератора. Без неё
/// «обычный участник может только игнорировать» означало бы, что позвать на
/// помощь нельзя вообще.
///
/// `excerpt` — копия текста на момент жалобы. Она нужна именно потому, что
/// нарушитель удаляет своё сообщение первым: без снимка модератор открыл бы
/// пустую карточку и не понял, о чём речь.
model GroupReport {
  id          String    @id @default(cuid())
  groupId     String
  reporterId  String
  targetId    String
  /// Сообщение, если жаловались на него. Внешнего ключа на Message нет
  /// намеренно: сообщение удалят, а жалоба должна пережить удаление.
  messageId   String?
  channelId   String?
  excerpt     String?   @db.VarChar(300)
  reason      String    @db.VarChar(300)
  /// OPEN | RESOLVED | DISMISSED
  status      String    @default("OPEN")
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reporter  User  @relation("GroupReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target    User  @relation("GroupReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  handledBy User? @relation("GroupReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  /// Одна жалоба на одно сообщение от одного человека — иначе кнопка
  /// превращается в способ завалить модератора одинаковыми карточками.
  @@unique([groupId, reporterId, messageId])
  @@index([groupId, status, createdAt])
  @@index([targetId])
}

/// MODERATION: персональный игнор. Раньше список жил в localStorage вкладки —
/// терялся при смене устройства и при очистке браузера. Теперь он привязан к
/// учётной записи.
model UserIgnore {
  id        String   @id @default(cuid())
  userId    String
  ignoredId String
  createdAt DateTime @default(now())

  user    User @relation("UserIgnoreOwner", fields: [userId], references: [id], onDelete: Cascade)
  ignored User @relation("UserIgnoreTarget", fields: [ignoredId], references: [id], onDelete: Cascade)

  @@unique([userId, ignoredId])
  @@index([ignoredId])
}

model GroupMember {
  mutedUntil    DateTime?
  muteReason    String?           @db.VarChar(300)
  guidedUntil   DateTime?		  // When role=GUIDE, the expiry datetime. Past = treated as MEMBER.
  id            String            @id @default(cuid())
  userId        String
  groupId       String
  role          String            @default("MEMBER")
  rulesAccepted Boolean           @default(false)
  sortOrder     Int               @default(0)
  muted         Boolean           @default(false)
  /// «Общественность»: накопленное время в голосовых каналах группы (секунды).
  voiceSeconds  Int               @default(0)
  /// «Профиль сервера»: имя, аватар и фон мини-профиля, свои для этой группы.
  /// Пусто — берётся глобальный профиль пользователя.
  displayName   String?           @db.VarChar(50)
  avatar        String?           @db.Text
  profileBanner String?           @db.Text
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tags          GroupMemberRole[]
  joinedAt      DateTime          @default(now())

  @@unique([userId, groupId])
  // Составной уникальный ключ начинается с userId, поэтому выборкам вида
  // «все участники сообщества» он не помогает — а их много: список участников,
  // упоминание @everyone, рассылки, подсчёты, удаление сообщества.
  @@index([groupId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  groupId   String
  createdBy String
  maxUses   Int       @default(0)
  uses      Int       @default(0)
  expiresAt DateTime?
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Channel {
  id               String                 @id @default(cuid())
  name             String
  type             String                 @default("TEXT")
  icon             String?
  groupId          String
  isRestricted     Boolean                @default(false)
  postAccess       String                 @default("ALL")
  // FIX-NEWSACL: кто может ЧИТАТЬ канал — ALL (все участники), MOD
  // (модераторы и выше) или ADMIN (владелец и администраторы). Дополняет
  // postAccess, который отвечает за право публиковать.
  readAccess       String                 @default("ALL")
  // FIX-QAACL: кто может ЗАДАВАТЬ вопросы и кто может ОТВЕЧАТЬ в разделе
  // «Вопросы-ответы». ALL | MOD | ADMIN | ROLES. ROLES — участники с тегами из
  // allowedRoles соответствующего scope (ASK / ANSWER).
  askAccess        String                 @default("ALL")
  answerAccess     String                 @default("ALL")
  hidden           Boolean                @default(false)
  slowmode         Int                    @default(0)
  serviceId        String?
  parentId         String?
  channelGroupType String?
  sortOrder        Int                    @default(0)
  parent           Channel?               @relation("ChannelTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Channel[]              @relation("ChannelTree")
  group            Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members          ChannelMember[]
  messages         Message[]
  polls            Poll[]
  tasks            ChannelTask[]
  allowedRoles     ChannelRoleAccess[]
  mutes            ChannelMute[]
  scheduledMsgs    ScheduledMessage[]
  qaThreads        QAThread[]
  appeals          Appeal[]
  wikiArticles     WikiArticle[]
  wikiCollections  WikiCollection[] // FIX-WIKI: полки базы знаний
  calendarEvents   CalendarEvent[]
  workspaceFiles   WorkspaceFile[]
  workspaceState   ChannelWorkspaceState? // GROUP-WORKSPACE: совместные холсты модуля CANVAS
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([groupId])
  @@index([serviceId])
    rolePowers  ChannelRolePower[]
  @@index([parentId])
}

model ChannelMember {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  role      String   @default("MEMBER")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  lastRead  DateTime @default(now())

  @@unique([userId, channelId])
  // Счётчик участников канала считается для каждого канала при открытии
  // сообщества; по одному userId-ключу это перебор таблицы.
  @@index([channelId])
}

model Message {
  id            String        @id @default(cuid())
  content       String
  userId        String
  channelId     String
  edited        Boolean       @default(false)
  editedAt      DateTime?
  deleted       Boolean       @default(false)
  pinned        Boolean       @default(false)
  pinnedBy      String?
  pinnedAt      DateTime?
  replyToId     String?
  replyTo       Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]     @relation("MessageReplies")
  threadId      String?
  threadParent  Message?      @relation("MessageThreads", fields: [threadId], references: [id], onDelete: SetNull)
  threadReplies Message[]     @relation("MessageThreads")
  threadCount   Int           @default(0)
  attachments   String?
  mentions      String?       @db.Text
  reactions     Reaction[]
  reads         MessageRead[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  /// NEWSPOST: поля ленты новостей.
  ///
  /// Пост — это то же самое сообщение. Отдельная таблица дала бы вторую копию
  /// всего, что у сообщения уже есть и что посту нужно один в один: вложения,
  /// реакции, закрепление, отметка о правке, ветка обсуждения (она же —
  /// комментарии). Пришлось бы дублировать и код вокруг: загрузку файлов,
  /// удаление автором, права модерации. Любая починка в одном месте не
  /// доезжала бы во второе.
  ///
  /// Поэтому поля необязательные и осмысленны только в канале type=NEWS: в
  /// обычной переписке они остаются пустыми и ни на что не влияют.

  /// Заголовок поста. Пусто — карточка показывает один текст.
  title          String?    @db.VarChar(200)
  /// Обложка карточки — путь внутри хранилища (/uploads/...). Чужой адрес сюда
  /// не попадает (см. sanitizePostCover): иначе лента стала бы способом
  /// подгружать картинку с чужого сервера и отдавать ему адреса читателей.
  cover          String?    @db.VarChar(400)
  /// Просмотры. Число хранится рядом с постом, потому что считать COUNT(*) по
  /// PostView на каждую карточку — это по подзапросу на строку ленты.
  views          Int        @default(0)
  /// Комментарии закрыты автором или модерацией.
  commentsClosed Boolean    @default(false)
  /// Черновик: виден только автору и никого не уведомляет.
  draft          Boolean    @default(false)
  /// Отложенная публикация: пока время не наступило, пост виден только автору.
  publishAt      DateTime?
  /// Когда разослали уведомление о публикации. Без этой отметки обход
  /// отложенных постов слал бы уведомление о каждом из них каждые полминуты —
  /// пост-то остаётся опубликованным.
  announcedAt    DateTime?
  postViews      PostView[]

  @@index([channelId, createdAt])
  @@index([replyToId])
  @@index([threadId])
  // Статистика за сутки считает сообщения без привязки к каналу — индекс по
  // каналу с датой такой запрос не покрывает.
  @@index([createdAt])
  // Список закреплённых в канале: их единицы на десятки тысяч сообщений.
  @@index([channelId, pinned])
  // NEWSPOST: лента новостей — закреплённые первыми, дальше по убыванию даты.
  @@index([channelId, pinned, createdAt])
  // NEWSPOST: обход отложенных публикаций идёт раз в полминуты. Без индекса
  // это перебор всей таблицы сообщений дважды в минуту.
  @@index([publishAt, announcedAt])
}

/// NEWSPOST: кто уже видел пост.
///
/// Одного счётчика на посте мало: без этих строк просмотры накручивались бы
/// обновлением страницы, и число под постом перестало бы что-либо значить.
/// Уникальность пары решает и гонку двух вкладок — на уровне базы, а не
/// проверкой «нет ли уже» перед вставкой, которая как раз в гонке и врёт.
model PostView {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

model DirectConversation {
  id            String          @id @default(cuid())
  /// PERSONAL: порядок пары не значит ничего (id сортируются при создании).
  /// BUSINESS: user1 — ВСЕГДА клиент, user2 — сторона администрации. Порядок
  /// здесь несёт смысл: по нему список деловых разговоров понимает, кто из двух
  /// человек заказчик, и не выводит клиенту его же имя вместо собеседника.
  user1Id       String
  user2Id       String
  user1         User            @relation("DMUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User            @relation("DMUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages      DirectMessage[]
  /// PERSONAL — обычная личная переписка, BUSINESS — разговор по обращению,
  /// SECURE — защищённая (E2EE) переписка с тем же человеком.
  ///
  /// Защищённый разговор — отдельная запись, а не флажок на сообщениях: иначе
  /// шифрованное и открытое лежат в одной ленте, и разделение держится только на
  /// фильтре в интерфейсе — то есть ни на чём.
  ///
  /// Разделение нужно, чтобы деловой разговор не терялся среди переписки с
  /// друзьями, а список «Сообщения» не разбавлялся заявками.
  kind          String          @default("PERSONAL") @db.VarChar(16)
  /// Обращение, из которого вырос разговор. Уникально: одно обращение — один
  /// чат, сколько бы раз администратор ни отвечал.
  appealId      String?         @unique
  /// Кто из администрации ведёт этот разговор. null — заявку ещё не взяли.
  ///
  /// Это и есть связка: доступ к деловому чату даёт роль (любой администратор и
  /// редактор видит очередь), а отвечает по заявке один человек, и остальные
  /// должны видеть, кто именно, — иначе двое отвечают одному клиенту разное.
  handlerId     String?
  handler       User?           @relation("DMHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  /// BUSINESS: администрация закрыла клиенту отправку сообщений в этом разговоре.
  ///
  /// Нужно потому, что игнорировать клиента в деловом разговоре нельзя: чёрного
  /// списка здесь нет и быть не может (сторона — администрация, а не человек), а
  /// закрытая заявка отправку не запрещала. Запрет односторонний: администрация
  /// отвечать по-прежнему может, иначе последнее слово осталось бы за клиентом.
  locked        Boolean         @default(false)
  lockedAt      DateTime?
  /// BUSINESS-PAY: счёт по этому деловому разговору. Один разговор — один счёт:
  /// разговор вырастает из одного обращения по одной задаче, и второй счёт в той же
  /// переписке означал бы, что клиент не понимает, за что именно платит.
  payment       BusinessPayment?
  lastMessageAt DateTime?
  user1ReadAt   DateTime?
  user2ReadAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  /// Парной уникальности здесь больше нет, и это исправление ошибки: с ключом
  /// [user1Id, user2Id, kind] второе обращение того же клиента к тому же
  /// администратору создать было НЕЛЬЗЯ — вставка падала на уникальности, а код
  /// молча оставался без чата. Одно обращение — один чат, и это уже гарантирует
  /// уникальный appealId. Для личной переписки уникал��ность пары сохранена
  /// частичным индексом (WHERE kind = 'PERSONAL') в миграции: Prisma частичные
  /// индексы описывать не умеет, поэтому в схеме он выглядит обычным.
  @@index([user1Id, user2Id, kind])
  @@index([kind, lastMessageAt])
  @@index([user1Id])
  @@index([user2Id])
  @@index([handlerId])
}

model DirectMessage {
  id             String             @id @default(cuid())
  content        String
  userId         String
  conversationId String
  edited         Boolean            @default(false)
  editedAt       DateTime?
  pinned         Boolean            @default(false)
  pinnedAt       DateTime?
  pinnedById     String?
  deleted        Boolean            @default(false)
  attachments    String?
  replyToId      String?
  encrypted      Boolean            @default(false)
  replyTo        DirectMessage?     @relation("DMReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DirectMessage[]    @relation("DMReply")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, pinned])
  @@index([replyToId])
  // То же, что у Message: сводка за сутки по всей таблице.
  @@index([createdAt])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String      @db.Text
  icon        String?
  imageUrl    String?
  rarity      String      @default("common")
  active      Boolean     @default(true)
  users       UserBadge[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  token     String   @unique
  active    Boolean  @default(true)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  category  String
  tags      String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  icon        String?
  order       Int     @default(0)
  active      Boolean @default(true)

  /// STAGES: свой набор этапов работ по этой услуге — [{ id, title }, …].
  ///
  /// null означает «набор не правили»: этапы берутся из каталога по названию
  /// услуги (см. lib/orderStages.ts). Пустой массив равносилен null и
  /// отбрасывается при чтении — услуга без единого этапа показала бы заказчику
  /// карточку без прогресса.
  ///
  /// Идентификатор этапа хранится ВМЕСТЕ с названием, а не выводится из
  /// порядка: по нему в проектах отмечены выполненные этапы. Переименование и
  /// перестановка идентификатор сохраняют — и отметки заказчиков переживают
  /// правку набора.
  stages      Json?

  /// BUSINESS-PAY: договоры и приложения, привязанные к услуге, —
  /// [{ id, name, url, size, mime, uploadedAt }, …].
  ///
  /// Хранятся Json, а не отдельной таблицей, по той же причине, что и stages:
  /// это небольшой список, который всегда читается целиком вместе с услугой и никогда
  /// не ищется поиском. Клиенту эти файлы ВИДНЫ ТОЛЬКО в его счёте — в самой услуге
  /// они не публичны (см. /api/services — поле не отдаётся наружу).
  documents   Json?

  projects    PartnerProject[]
  payments    BusinessPayment[]
}

// Custom roles (tags) for groups — no admin/mod powers, just labels
model GroupRole {
  id              String              @id @default(cuid())
  name            String
  color           String              @default("#808080")
  priority        Int                 @default(0)
  groupId         String
  group           Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members         GroupMemberRole[]
  channels        ChannelRoleAccess[]
  channelPowers   ChannelRolePower[]
  onboardingForms OnboardingForm[]
  createdAt       DateTime            @default(now())

  @@unique([groupId, name])
  @@index([groupId])
}

// Many-to-many: which members have which tags
model GroupMemberRole {
  id       String      @id @default(cuid())
  memberId String
  roleId   String
  member   GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     GroupRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([roleId])
}

// Which roles can see a restricted channel.
// FIX-QAACL: одна и та же таблица хранит теперь три независимых списка тегов —
// scope различает, для чего роль допущена: VIEW (видеть раздел, прежнее
// поведение), ASK (задавать вопросы), ANSWER (отвечать).
model ChannelRoleAccess {
  id        String    @id @default(cuid())
  channelId String
  roleId    String
  scope     String    @default("VIEW")
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role      GroupRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId, scope])
  @@index([channelId])
}

/// CHANNEL-ROLE-POWER: Роли-возможности.
/// Привязывает системную роль (GroupRole) к конкретному каналу.
/// Участник, имеющий эту роль, получает полную модерацию данного канала,
/// но только его — к остальным каналам права не применяются.
model ChannelRolePower {
  id        String    @id @default(cuid())
  roleId    String
  channelId String
  createdAt DateTime  @default(now())
  role      GroupRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([roleId, channelId])
  @@index([roleId])
  @@index([channelId])
}

/// SERVER-MESH: реестр серверов проекта. Ровно одна запись с role = "MAIN" —
/// сервер, где живёт это приложение; остальные — дочерние узлы (медиа, VPN,
/// вычисления), которые сами отчитываются о себе по токену агента.
///
/// Токен в открытом виде НЕ хранится: в базе только SHA-256, а сам токен
/// показывается администратору один раз при создании или перевыпуске.
model ServerNode {
  id   String @id @default(cuid())
  name String @unique
  /// MAIN | CHILD
  role String @default("CHILD")
  /// Назначение узла: APP | MEDIA | VPN | COMPUTE | STORAGE
  kind String @default("APP")
  /// Базовый адрес для служебных запросов, например https://vpn1.example.ru.
  /// У VPN-узла смысла не имеет: связка работает «на вытягивание», мы никогда
  /// не обращаемся к узлу по HTTP.
  url    String @default("")
  /// VPN-ENDPOINT: точка подключения WireGuard для клиентов — IP или домен и
  /// UDP-порт, например «203.0.113.10:51820». У WireGuard нет URL: клиент
  /// пишет в конфиг именно host:port, поэтому для VPN-узла это и есть
  /// «адрес». Пусто — берём то, что узел сообщил о себе в отчёте.
  endpointHost String @default("")
  /// VPN-TRANSPORT: PLAIN | OBFUSCATED. Выбирает администратор в карточке узла.
  /// OBFUSCATED означает, что на машине поднят обфусцированный вариант WireGuard
  /// и клиентам нужно выдавать соответствующие параметры. Название протокола
  /// намеренно не фигурирует ни в поле, ни в интерфейсе.
  transport String @default("PLAIN")
  /// Параметры обфускации, как их сообщил агент узла: JSON вида
  /// {"Jc":4,"Jmin":40,...}. Не секрет, но и не для показа — они просто
  /// подставляются в выдаваемый профиль. Пусто = узел их ещё не сообщил.
  obfuscation String @default("") @db.Text
  region      String @default("")
  /// VPN-EXIT: пул внешних адресов узла через запятую, например
  /// "1.2.3.4, 1.2.3.5". Один узел = один внешний IP на всех — это и есть
  /// главный потолок масштабирования; пул его снимает. Пусто — узел выпускает
  /// трафик своим основным адресом через MASQUERADE, как раньше.
  publicIps String @default("")
  /// STORAGE-PRIORITY: адрес объектного хранилища узла (S3-совместимый), вида
  /// https://files1.example.ru:9000. Пусто — узел файлы не принимает и в выборе
  /// места не участвует, даже если помечен как STORAGE. Это намеренно: узел без
  /// настроенного хранилища ничем не лучше главного сервера, и молча гонять на
  /// него файлы значило бы терять их.
  storageEndpoint String @default("")
  /// Имя корзины на узле.
  storageBucket String @default("")
  /// Регион для подписи запроса. Для собственного узла подходит любой, важно
  /// лишь совпадение с настройкой самого хранилища.
  storageRegion String @default("us-east-1")
  /// Идентификатор ключа доступа. Сам по себе не секрет — секрет ниже.
  storageKeyId String @default("")
  /// Секретный ключ, зашифрованный ENCRYPTION_SECRET (см. lib/encryption).
  /// В открытом виде не хранится и наружу не отдаётся никогда.
  storageSecretEnc String @default("") @db.Text
  /// SHA-256 токена агента в hex.
  tokenHash String?
  /// Последний отчёт узла (JSON: версия, нагрузка, число пиров).
  lastReport String?   @db.Text
  lastSeenAt DateTime?
  enabled    Boolean   @default(true)
  note       String    @default("") @db.VarChar(300)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vpnPeers VpnPeer[]

  @@index([role])
  @@index([kind])
}

/// VPN-PANEL: единственная запись с настройками сервиса VPN (id = "default").
///
/// `enabled` — настоящий выключатель, а не косметика: при выключении узлам в
/// ответе на отчёт уходит ПУСТОЙ список пиров, и через минуту все туннели
/// реально отпадают. Кнопка, которая прячет интерфейс, но оставляет доступ
/// работающим, хуже отсутствия кнопки.
model VpnSettings {
  id      String  @id @default("default")
  enabled Boolean @default(false)
  /// DNS, который получает клиент внутри туннеля.
  dns String @default("1.1.1.1")
  /// VPN-ROUTING: маршруты режима «весь трафик» — того, что человек выбирает
  /// первым вариантом при включении.
  allowedIps String @default("0.0.0.0/0, ::/0")
  /// VPN-ROUTING: маршруты режима «только сервисы TZ» — второго варианта выбора.
  /// Здесь перечисляются адреса самого проекта; по умолчанию только подсеть
  /// туннеля. Смысл вариантов задаёт администратор, выбор между ними — человек.
  serviceAllowedIps String @default("10.8.0.0/24")
  /// Потолок пиров на один узел — выбор узла уважает вместимость.
  maxPeersPerNode Int      @default(200)
  /// NETLINK: сколько гигабайт в расчётном периоде полагается одному
  /// подписчику. Лимит ОДИН и тот же для обеих подписок: и для Premium,
  /// и для «Ускоренного интернета». Разные лимиты по подпискам означали бы
  /// два разных качества одной и той же услуги — человек этого не ожидает.
  /// 0 означает «без ограничения».
  trafficLimitGb Int @default(250)
  /// NETLINK: длина расчётного периода в днях. Период личный у каждого и
  /// считается от момента выдачи доступа, а не от первого числа месяца:
  /// иначе подключившийся 30-го получал бы сутки вместо месяца.
  usagePeriodDays Int @default(30)
  /// NETLINK: что происходит при исчерпании лимита: BLOCK — соединение
  /// снимается до конца периода, THROTTLE — остаётся, но с урезанной
  /// скоростью. Ограничение скорости исполняет сам узел: главный сервер трафик
  /// не видит и формировать его не может.
  overLimitAction String @default("BLOCK")
  /// NETLINK: скорость после исчерпания лимита, Кбит/с. Имеет смысл только
  /// при overLimitAction = THROTTLE.
  throttleKbps Int      @default(2048)
  updatedAt    DateTime @updatedAt
}

/// VPN-WG: пир WireGuard, привязанный к аккаунту. Один аккаунт — один пир
/// (`userId @unique`), поэтому доступ нельзя размножить по устройствам.
///
/// ПРИВАТНОГО КЛЮЧА ЗДЕСЬ НЕТ И БЫТЬ НЕ МОЖЕТ. Пара ключей создаётся на
/// устройстве владельца, приватная половина остаётся в защищённом хранилище ОС
/// и не покидает машину; на сервер уходит только публичный ключ. Поэтому ни
/// администратор, ни сама система физически не могут выдать чужой доступ —
/// выдавать нечего.
model VpnPeer {
  id     String @id @default(cuid())
  userId String @unique
  nodeId String
  /// Публичный ключ WireGuard (base64, 44 символа).
  publicKey String @unique
  /// Адрес внутри туннеля, например 10.8.0.7. Уникален В ПРЕДЕЛАХ УЗЛА (см.
  /// `@@unique` ниже): подсеть у каждого узла своя и одинаковая, поэтому
  /// 10.8.0.2 на двух узлах — это два разных туннеля.
  address String
  /// VPN-EXIT: закреплённый внешний адрес выхода. Закрепление важно: у банков и
  /// сессий смена внешнего IP посреди работы означает разлогин, поэтому адрес
  /// выдаётся один раз и держится за пиром. Пусто — общий MASQUERADE узла.
  exitIp          String    @default("")
  /// VPN-ROUTING: что идёт через туннель у этого человека — ALL либо SERVICES.
  /// Выбирается при выдаче доступа; смена режима означает перевыпуск профиля,
  /// потому что `AllowedIPs` живёт в конфиге на устройстве.
  routing         String    @default("ALL")
  enabled         Boolean   @default(true)
  /// Последнее рукопожатие, как его увидел агент узла.
  lastHandshakeAt DateTime?
  /// Метка устройства для самого владельца — понять, что за пир.
  label String @default("") @db.VarChar(80)

  /// NETLINK: потраченный трафик за текущий расчётный период, байты.
  /// Тип Float, а не BigInt, намеренно: двойная точность точно считает целые
  /// до 9 ПБ, а BigInt не сериализуется в JSON без ручного преобразования в
  /// каждом ответе — один забытый маршрут и падение в работе.
  rxBytes Float @default(0)
  txBytes Float @default(0)
  /// NETLINK: последние сырые счётчики узла. У WireGuard они накопительные с
  /// момента подъёма интерфейса и обнуляются при его перезапуске, поэтому
  /// в расход идёт ПРИРОСТ, а не само число: иначе перезагрузка узла
  /// списывала бы человеку его же трафик второй раз.
  lastRx Float @default(0)
  lastTx Float @default(0)
  /// NETLINK: начало текущего расчётного периода.
  usageResetAt DateTime @default(now())
  /// NETLINK-FRESH: когда узел последний раз присылал счётчики ЭТОГО пира.
  /// Пусто — учёт по подключению ещё не приходил ни разу, и это не то же самое,
  /// что «израсходовано 0»: показывать ноль там, где данных нет, значит
  /// уверенно сообщать неправду.
  usageUpdatedAt DateTime?
  /// VPN-APPLY: когда последний раз менялась КОНФИГУРАЦИЯ туннеля — ключ, узел,
  /// адрес, режим маршрутизации. По ней клиент понимает, узнал ли узел о его
  /// текущем ключе: отчёт узла позже этой отметки означает «пир уже стоит».
  /// Отдельное поле, а не `updatedAt`: последний растёт и от записи счётчиков
  /// трафика, то есть от собственного отчёта узла.
  configAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  node ServerNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// Адрес занят в пределах узла, а не всей системы. Глобальная уникальность
  /// была прямой поломкой второго узла: адреса выдаются из подсети узла, и
  /// первый же пир на новом узле получал отказ на записи, а не доступ.
  @@unique([nodeId, address])
  @@index([nodeId])
}

