// Журнал аудита модераторских действий внутри группы.
// Пишется из API-маршрутов через src/lib/groupAudit.ts.
model GroupAuditEntry {
  id         String   @id @default(cuid())
  groupId    String
  actorId    String
  actorName  String
  action     String   // settings.update | member.role | member.kick | member.timeout | member.untimeout | ban.add | ban.remove | invite.create | invite.revoke
  targetId   String?
  targetName String?
  details    String?  @db.Text
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([groupId, createdAt])
}
