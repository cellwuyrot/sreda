// ВАЖНО: ЗАМЕНИТЬ существующую модель AboutBlock в prisma/schema.prisma
// (не добавлять в конец — модель уже есть со старыми полями!)
//
// Найдите блок «model AboutBlock { ... }» и замените его целиком на этот:
// ══════════════════════════════════════════════════════════════════════════════

model AboutBlock {
  id        String   @id @default(cuid())
  type      String                         // hero | video | stats | gallery | bento | timeline | team | cta
  position  Int      @default(0)
  data      String   @default("{}") @db.Text  // JSON-строка с данными блока
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([type])
}
