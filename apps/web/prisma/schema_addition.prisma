// ─────────────────────────────────────────────────────────────────────────────
// ВАЖНО: ЗАМЕНИТЕ существующую модель AboutBlock в prisma/schema.prisma
// (не добавляйте в конец — модель уже существует со старой схемой!)
// ─────────────────────────────────────────────────────────────────────────────

model AboutBlock {
  id        String   @id @default(cuid())
  type      String   // hero | video | stats | gallery | bento | timeline | team | cta
  position  Int      @default(0)
  data      String   @default("{}") @db.Text
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([type])
}
