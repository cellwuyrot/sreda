# ─── TrioZ Connect Desktop configuration ────────────────────────────
# All values are optional; sensible defaults are used when omitted.

# URL of the TrioZ Connect web frontend the desktop shell should load.
# Point this at your local dev server (http://localhost:3000) while
# developing, or leave it at the production deployment. The shell always opens
# the `/connect` section of this origin (never the website landing grid).
TRIOZ_APP_URL="https://trioz.ru"

# Set to 1 to open DevTools and enable verbose logging on launch.
# TRIOZ_DEV=1
