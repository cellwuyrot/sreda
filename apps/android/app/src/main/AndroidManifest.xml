<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core connectivity: the shell renders a remote site. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice channels & video: microphone and camera (WebRTC). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Location sharing on the map. Optional — the app degrades gracefully. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 13+ runtime notification permission (in-app toasts and push). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nothing here is mandatory, so the app installs on all devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".ConnectApp"
        <!-- FIX-SEC: было "true". При включённой резервной копии данные
             приложения (cookie сессии в WebView, токен доставки) уезжают в облако
             и снимаются через adb backup с разблокированного телефона — то есть
             войти в аккаунт можно без пароля. Мессенджеру резервная копия
             состояния не нужна: вся переписка и так на сервере. -->
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Connect"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|navigation"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Connect.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          PUSH: доставка уведомлений в ЗАКРЫТОЕ приложение.

          Раньше уведомления показывались только пока приложение открыто: они
          приходили живым соединением, и выгруженный системой процесс молчал.
          Служба доставки живёт в самой ОС и будит приложение ровно на время
          показа уведомления — без вечной плашки «приложение работает» и без
          расхода батареи на удержание соединения.

          exported=false: службу вызывает только система доставки, снаружи к ней
          обратиться нельзя.
        -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Канал по умолчанию — тот же, что у уведомлений от живого соединения:
             человеку не нужны две одинаковые категории в настройках приложения. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tz_connect_messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>
</manifest>
