<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core connectivity: the shell renders a remote site. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice channels & video: microphone and camera (WebRTC). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Location sharing on the map. Optional — the app degrades gracefully. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 13+ runtime notification permission (in-app toasts and push). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      CALL: входящий звонок поверх блокировки.

      USE_FULL_SCREEN_INTENT — разрешение разворачивать окно сразу, а не показывать
      полоску в шторке. Без него вызов на закрытом телефоне выглядит как
      обычное уведомление, и его просто не заметят. С Android 14 оно выдаётся
      только приложениям со звонками — это как раз наш случай.

      WAKE_LOCK — разбудить экран на время вызова.

      FIX-BOOT: разрешений FOREGROUND_SERVICE* здесь больше нет. Они были взяты
      «на будущее», но фоновой службы разговора в приложении нет: разговор
      идёт в веб-части. Объявленные, но неиспользуемые разрешения на Android 14
      только мешают: система требует под каждое обоснование и тип службы.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Nothing here is mandatory, so the app installs on all devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- FIX-SEC: android:allowBackup был "true". При включённой резервной копии
         данные приложения (cookie сессии в WebView, токен доставки) уезжают в
         облако и снимаются через adb backup с разблокированного телефона — то
         есть войти в аккаунт можно без пароля. Мессенджеру резервная копия
         состояния не нужна: вся переписка и так на сервере.

         Важно: комментарий стоит ПЕРЕД тегом, а не среди его атрибутов:
         комментарий внутри открывающего тега — невалидный XML, и сборка apk
         падает на разборе манифеста. -->
    <application
        android:name=".ConnectApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Connect"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|navigation"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Connect.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          CALL: окно входящего вызова.

          showWhenLocked + turnScreenOn — то, зачем вся эта отдельная страница и
          существует: экран загорается сам, и вызов виден без разблокировки,
          как у телефонного звонка.

          excludeFromRecents — завершённый вызов не должен оставаться в недавних:
          открытый из недавних снимок показал бы вызов, которого больше нет.

          exported=false: окно открывает только служба доставки внутри приложения.
          Стороннее приложение иначе могло бы рисовать поддельный вызов поверх
          блокировки от имени мессенджера.
        -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Connect" />

        <!--
          PUSH: служба доставки описана В ОТДЕЛЬНОМ манифесте app/src/push.

          FIX-BOOT: раньше служба и библиотека доставки попадали в ЛЮБУЮ сборку,
          включая сборку без файла доступов app/google-services.json (в репозитории
          его нет и быть не должно). Библиотека доставки поднимается при старте
          процесса сама, до первого экрана, и без своего файла доступов роняла
          приложение ещё на запуске — вместо мессенджера человек видел «произошёл
          сбой». Теперь вся доставка подключается только вместе с файлом доступов:
          без него приложение собирается и работает, просто без уведомлений в
          закрытом состоянии. См. apps/android/app/build.gradle.kts.
        -->
    </application>
</manifest>
