<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- FIX-BOOT: послабление для локальных адресов вынесено на ВЕРХНИЙ уровень.

         Раньше <domain-config> был вложен в <debug-overrides>. Спецификация
         Android разрешает внутри <debug-overrides> только <trust-anchors>; любой
         другой тег (в том числе <domain-config>) валит разбор конфигурации сети
         с ParserException. Разбор ленивый — он случается при первом сетевом
         запросе WebView, уже после сплэш-экрана, поэтому приложение стабильно
         падало сразу после запуска (только в отладочной сборке, где
         debug-overrides вообще применяется).

         Здесь cleartext (HTTP) разрешён ТОЛЬКО для петлевых адресов эмулятора и
         локальной машины. Весь остальной трафик остаётся строго по HTTPS:
         android:usesCleartextTraffic="false" в манифесте закрывает всё прочее, а
         боевой адрес connect.trioz.ru и так ходит только по HTTPS. Риск от
         послабления минимален: 10.0.2.2/localhost/127.0.0.1 доступны лишь с
         самого устройства. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
