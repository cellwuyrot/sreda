# Same PostgreSQL and Redis as TrioZ. Separate host-only cookies, not shared NextAuth secret.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/trioz
REDIS_URL=redis://127.0.0.1:6379
TZ_ID_ISSUER=https://id.trioz.ru
TZ_ID_WEB_ORIGIN=https://trioz.ru
PORT=3100
# Generate via npm run keys -w apps/id. Never commit actual values.
TZ_ID_JWKS_FILE=/var/www/trioz/apps/id/secrets/jwks.json
TZ_ID_STORAGE_KEY=
TZ_ID_COOKIE_KEYS=
TRUSTED_PROXY_HOPS=1
# Only local integration tests; NEVER enable on production.
TZ_ID_DEV_ALLOW_HTTP=0
