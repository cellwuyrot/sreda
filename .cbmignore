# codebase-memory-mcp ignore rules (gitignore syntax)
# Слои игнорирования: встроенные (.git, node_modules) -> .gitignore -> этот файл

# Мёртвая директория с дублями кода (никем не импортируется) — исключаем,
# чтобы в графе не было дублей символов
apps/apps/

# Статические ассеты веб-приложения (иконки, эмодзи, игровые арты) — не код
apps/web/public/

# Генерируемый лок-файл npm — огромный JSON без смысловой нагрузки для графа
package-lock.json

# Случайно закоммиченный текстовый артефакт
apps/web/cm6.txt
